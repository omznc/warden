# Claude Code login. Run "claude setup-token" to get a token.
CLAUDE_CODE_OAUTH_TOKEN=
# OpenRouter alternative: remove the OAuth token and set these instead.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=""
POSTHOG_API_KEY_PERSONAL=
POSTHOG_API_KEY_WORK=
GH_TOKEN=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
# Example: http://hermes-gateway:8644/webhooks/warden
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_SECRET=
# dry, issues or prs
MODE=
INTERVAL_HOURS=
CLAUDE_MODEL=
MAX_TURNS=
MAX_NEW_ISSUES=
# UI login (WARDEN_PASSWORD is required), user name (default admin) and public URL for notifications
WARDEN_PASSWORD=
WARDEN_USER=
# Empty: notices have no review link
WARDEN_URL=

# PostHog events about the runs and the items (optional). A project API token starts with phc_.
# The runner reads them. The agent never gets them. Leave the token empty to send no event.
WARDEN_POSTHOG_TOKEN=
# Default: https://eu.i.posthog.com
WARDEN_POSTHOG_HOST=
